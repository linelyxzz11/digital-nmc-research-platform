# Python csv.writer emits RFC 4180 CRLF; keep raw experiment bytes intact.
.gitattributes text eol=lf
*.csv -text whitespace=cr-at-eol
*.py text eol=lf
*.sv text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
requirements.txt text eol=lf
*.yml text eol=lf
*.ps1 text eol=lf
*.cs text eol=lf
*.svg text eol=lf
docs/gemv_8x8_validation/*.txt text eol=lf
